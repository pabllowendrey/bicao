<form method="post" action="/login/logging" class="form-signin">
  <h1 class="h3 mb-3 font-weight-normal">Login da Área Administrativa</h1>
  <label for="email" class="sr-only">Email</label>
  <input type="email" id="email" name="email" class="form-control" placeholder="E-mail" required="" autofocus="">
  <label for="password" class="sr-only">Senha</label>
  <input type="password" id="password" name="password" class="form-control" placeholder="Password" required="">
  <div class="checkbox mb-3">
    <label>
      <input type="checkbox" value="1" name="remember"> Lembrar de mim
    </label>
  </div>
  <button class="btn btn-lg btn-primary btn-block" type="submit">Login</button>
</form>
